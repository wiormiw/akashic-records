# Base URL of the Akashic API. No trailing slash.
PUBLIC_API_BASE=http://localhost:3000

# Canonical origin of this site, used for canonical links and social cards.
PUBLIC_SITE_URL=http://localhost:5173

# Origin serving uploaded images; must match the API's S3_PUBLIC_URL. Shapes the CSP img-src.
PUBLIC_MEDIA_ORIGIN=http://localhost:9000
