{
	"name": "@akashic/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test src build-config.test.ts",
		"format": "prettier --write 'src/**/*.svelte' src/app.css src/app.html",
		"format:check": "prettier --check 'src/**/*.svelte' src/app.css src/app.html",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@akashic/contracts": "workspace:*",
		"@akashic/lib": "workspace:*",
		"@tanstack/svelte-query": "^6.1.46",
		"clsx": "^2.1.1",
		"motion": "^13.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"oxlint": "^1.80.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4"
	}
}
