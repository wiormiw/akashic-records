{
	"name": "@akashic/web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test src build-config.test.ts",
		"format": "prettier --write 'src/**/*.svelte' src/app.css src/app.html",
		"format:check": "prettier --check 'src/**/*.svelte' src/app.css src/app.html",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@akashic/contracts": "workspace:*",
		"@akashic/lib": "workspace:*",
		"@tanstack/svelte-query": "^6.3.6",
		"clsx": "^2.1.1",
		"motion": "^14.8.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^4.0.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"oxlint": "^1.90.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"wrangler": "^4.156.0"
	}
}
