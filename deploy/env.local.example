# The local rehearsal of the VPS stack. `deploy/up-local.sh` copies this to deploy/.env.local
# (gitignored), replacing each __TOKEN__ with a random secret. Not the dev stack: that is the
# root compose.yaml and .env.

# --- compose --------------------------------------------------------------------------------
# Caddy listens on 8300 inside, published on loopback only.
API_SITE_ADDRESS=http://localhost:8300
CADDY_HTTP=127.0.0.1:8300
CADDY_HTTP_INNER=8300
CADDY_HTTPS=127.0.0.1:8302

POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
OPENFGA_DB_PASSWORD=__OPENFGA_DB_PASSWORD__
RABBITMQ_PASSWORD=__RABBITMQ_PASSWORD__

# Backups go to the `minio` service (profile `local`), which uses these as its root login.
BACKUP_BUCKET=akashic-backups
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_ACCESS_KEY_ID=akashic-backup
BACKUP_S3_SECRET_ACCESS_KEY=__BACKUP_S3_SECRET_ACCESS_KEY__
BACKUP_KEEP_DAYS=14
# Optional: pinged after each successful backup (healthchecks.io style). Leave unset locally.
# BACKUP_HEARTBEAT_URL=

# The web rehearsal (--web): baked into its CSP at build time, and used by its server too.
PUBLIC_API_BASE=http://localhost:8300
WEB_PORT=8301

# --- API ------------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

DATABASE_URL=postgres://akashic:__POSTGRES_PASSWORD__@postgres:5432/akashic?sslmode=disable
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://akashic:__RABBITMQ_PASSWORD__@rabbitmq:5672

BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__
# The address the browser reaches the API at, which is Caddy.
BETTER_AUTH_URL=http://localhost:8300
# The browser's origin for the web (port 8301). Cookies are scoped by host, not port, so the web
# at :8301 and the API at :8300 share them; CORS and better-auth's trusted origins still need
# the exact origin.
CORS_ORIGINS=http://localhost:8301
# Caddy is in front, as on the VPS; the rehearsal checks the client address survives it.
TRUST_PROXY=true

# Filled in by up-local.sh after the authz push.
FGA_API_URL=http://openfga:8080
FGA_STORE_ID=
FGA_MODEL_ID=

AI_PROVIDER=gemini
