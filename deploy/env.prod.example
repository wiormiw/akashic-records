# The VPS environment: copy to /opt/akashic/.env (mode 600). Production keeps it as the GitHub
# secret API_ENV. Placeholders only; never commit real values.
# Read twice by Docker Compose: as the API's environment, and for the ${VARS} in compose.prod.yaml.

# --- compose --------------------------------------------------------------------------------
# What Caddy serves. A bare domain switches on automatic HTTPS, so DNS must already point here.
API_SITE_ADDRESS=api.example.com

# Passwords for the stack's own services. `openssl rand -hex 32`. Hex keeps them URL-safe,
# which the connection strings below depend on.
POSTGRES_PASSWORD=replace-me
OPENFGA_DB_PASSWORD=replace-me
RABBITMQ_PASSWORD=replace-me

# --- API ------------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# The password here must equal POSTGRES_PASSWORD.
DATABASE_URL=postgres://akashic:replace-me@postgres:5432/akashic?sslmode=disable
# Rate-limit counters. No password: the service is reachable only inside the stack.
REDIS_URL=redis://redis:6379
# The password here must equal RABBITMQ_PASSWORD.
RABBITMQ_URL=amqp://akashic:replace-me@rabbitmq:5672

# At least 32 characters. Signs sessions and room tickets; changing it signs everyone out.
# `openssl rand -hex 32`. The placeholder is too short on purpose: the API refuses to start on it.
BETTER_AUTH_SECRET=CHANGE_ME
# The public address of this API; verification links are built from it.
BETTER_AUTH_URL=https://api.example.com
# The web's origin(s), comma-separated, not a JSON array. The first is where verification
# links send the reader on to.
CORS_ORIGINS=https://akashic.example.com
# Caddy is in front, so the client's address is in X-Forwarded-For. Without this every client
# shares Caddy's rate-limit bucket. Never set it on an API that is reachable without a proxy.
TRUST_PROXY=true

# OpenFGA is the stack's `openfga` service. Leave the ids empty on first boot: the runbook runs
# the authz push and you paste what it prints, then `up -d` the API. The API refuses to start
# without FGA_STORE_ID.
FGA_API_URL=http://openfga:8080
FGA_STORE_ID=
# Pin it: a model pushed mid-rollout changes what running containers authorize.
FGA_MODEL_ID=

# Optional: embeddings for realm fit. Without them fit isn't checked.
AI_PROVIDER=gemini
AI_API_KEY=
AI_EMBED_MODEL=gemini-embedding-001

# Optional: mail. Without a key nothing is sent.
# RESEND_API_KEY=
# MAIL_FROM=Akashic Records <noreply@example.com>

# Optional: image uploads (Task 3 adds the storage). Unset bucket means uploads are refused.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
