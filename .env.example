# Copy to .env. Values match compose.yaml.
DATABASE_URL=postgres://akashic:akashic@localhost:5432/akashic?sslmode=disable
REDIS_URL=redis://localhost:6379
# Outbox events go through RabbitMQ; the management UI is on http://localhost:15672.
RABBITMQ_URL=amqp://akashic:akashic@localhost:5672
PORT=3000

# At least 32 characters. Signs sessions and room tickets; changing it signs everyone out.
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# The address a browser reaches, since verification links are built from it.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated, not a JSON array.
CORS_ORIGINS=http://localhost:5173

# From `bun run authz:push`.
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=

# Optional: embeddings for realm fit. Without them, fit isn't checked.
AI_PROVIDER=gemini
AI_API_KEY=
AI_EMBED_MODEL=gemini-embedding-001

# Optional.
# RESEND_API_KEY=
# S3_BUCKET=akashic
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_URL=http://localhost:9000/akashic
# The values match compose.yaml's MinIO.
# S3_ACCESS_KEY_ID=akashic
# S3_SECRET_ACCESS_KEY=akashic-dev-secret
