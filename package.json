{
	"name": "akashic-records",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun --filter @akashic/api dev",
		"db:generate": "bun --filter @akashic/db generate",
		"db:migrate": "bun --env-file=.env apps/api/scripts/migrate.ts",
		"authz:push": "bun --env-file=.env apps/api/scripts/authz-push.ts",
		"authz:backfill": "bun --env-file=.env apps/api/scripts/authz-backfill.ts",
		"events:replay": "bun --env-file=.env apps/api/scripts/events-replay.ts",
		"admin:grant": "bun --env-file=.env apps/api/scripts/admin-grant.ts",
		"realm:centroids": "bun --env-file=.env apps/api/scripts/realm-centroids.ts",
		"format": "oxfmt apps packages && bun --filter @akashic/web format",
		"format:check": "oxfmt --check apps packages && bun --filter @akashic/web format:check",
		"lint": "oxlint --deny-warnings apps packages",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun test apps/api packages && bun --filter @akashic/web test",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
		"dev:web": "bun --filter @akashic/web dev"
	},
	"devDependencies": {
		"@types/bun": "1.4.3",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.86.0",
		"typescript": "^7.0.2"
	}
}
